# ══════════════════════════════════════════════════════════════
#  STAGE 1 — BUILDER
#  Uses Maven to compile and package the application
#  This stage is thrown away after building
#  Nothing from here except the JAR reaches production
# ══════════════════════════════════════════════════════════════

FROM eclipse-temurin:21-jdk-alpine AS builder

# eclipse-temurin = the official OpenJDK distribution
# 21               = Java 21 (required by Spring Boot 4)
# jdk              = full JDK needed for compilation
# alpine           = minimal Linux distro — keeps image small
# AS builder       = name this stage "builder"

# Set working directory inside the container 
# All subsequent commands run from here
WORKDIR /app

# ── Copy pom.xml FIRST (layer caching trick) ──────────────────
# If pom.xml has not changed Docker uses cached dependency layer
# Only re-downloads when pom.xml actually changes
COPY pom.xml .

# Download all dependencies into the container
# -B = batch mode (no progress bars — cleaner logs)
# --no-transfer-progress = even quieter downloads
# dependency:go-offline = download everything needed
RUN mvn dependency:go-offline -B --no-transfer-progress \
    || mvn dependency:resolve -B --no-transfer-progress

# ── Now copy source code ──────────────────────────────────────
# This layer changes every time you modify code
# But dependency layer above is still cached
COPY src ./src

# ── Build the application ─────────────────────────────────────
# -DskipTests = skip running tests during Docker build
#               Tests already ran via mvn test
#               Running them again here slows the build
# package     = compile + run tests (skipped) + create JAR
RUN mvn package -DskipTests -B --no-transfer-progress

# ══════════════════════════════════════════════════════════════
#  STAGE 2 — RUNNER
#  Minimal image containing ONLY what is needed to run
#  No Maven. No source code. No build tools.
#  Just Java + the JAR file.
# ══════════════════════════════════════════════════════════════

FROM eclipse-temurin:21-jre-alpine AS runner

# jre = Java Runtime Environment only
#       Smaller than JDK — cannot compile code
#       Perfect for running — cannot be used to modify code
#       Security benefit: attacker cannot recompile anything

WORKDIR /app

# ── Security: run as non-root user ───────────────────────────
# By default Docker runs as root inside the container
# That is a security risk — if the app is compromised
# the attacker has root access to the container
# Creating a dedicated user limits the blast radius
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# ── Copy ONLY the JAR from the builder stage ─────────────────
# --from=builder = take files from the builder stage
# target/*.jar   = the compiled JAR Maven produced
# app.jar        = rename it for simplicity
COPY --from=builder /app/target/*.jar app.jar

# Give the non-root user ownership of the JAR
RUN chown appuser:appgroup app.jar

# Switch to non-root user
USER appuser

# ── Expose the port ───────────────────────────────────────────
# EXPOSE documents which port the app listens on
# It does NOT actually open the port
# docker-compose or docker run -p does the actual opening
EXPOSE 8080

# ── JVM optimisation for containers ──────────────────────────
# Without these the JVM does not know it is inside a container
# It sees the HOST machine's CPU and RAM — not the container's
# And allocates way too much memory

ENV JAVA_OPTS="\
  -XX:+UseContainerSupport \
  -XX:MaxRAMPercentage=75.0 \
  -XX:+UseG1GC \
  -Djava.security.egd=file:/dev/./urandom"

# -XX:+UseContainerSupport  = JVM respects container memory limits
# -XX:MaxRAMPercentage=75.0 = use max 75% of container RAM for heap
# -XX:+UseG1GC              = G1 garbage collector — best for web apps
# -Djava.security.egd=...   = faster startup — avoids entropy issues

# ── Start the application ─────────────────────────────────────
# ENTRYPOINT = the command that runs when container starts
# exec form ["java",...] is preferred over shell form
# because signals (Ctrl+C, docker stop) are handled correctly
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
